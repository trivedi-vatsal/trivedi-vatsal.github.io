---
import { getImage } from 'astro:assets'
import { render } from 'astro:content'
import type { CollectionEntry } from 'astro:content'
import BlogPageLayout from './BlogPageLayout.astro'
import { ShareMenu } from '../components/share-menu'
import { TOCInline } from '../components/toc-inline'
import { TOCMinimap } from '../components/toc-minimap'
import { Toaster } from '../components/ui/sonner'
import defaultOgImage from '../assets/images/View1.png'
import { SITE } from '../lib/constants'
import { formatReadingTime, getReadingTime, slugifyTag } from '../lib/blog'
import { blogPostingJsonLd } from '../lib/seo'

interface Props {
  post: CollectionEntry<'blog'>
}

const { post } = Astro.props
const { Content, headings } = await render(post)
const author = post.data.author ?? SITE.AUTHOR
const modifiedDate = post.data.updatedDate ?? post.data.pubDate
const readingTime = getReadingTime(post.body)
const site = Astro.site ?? 'https://vatsal.xyz'
const shareUrl = new URL(`/blog/${post.id}/`, site).href
const toc = headings
  .filter((heading) => heading.depth >= 2 && heading.depth <= 4)
  .map((heading) => ({
    title: heading.text,
    url: `#${heading.slug}`,
    depth: heading.depth,
  }))

const optimizedOg = await getImage({
  src: defaultOgImage,
  width: 1200,
  height: 630,
  format: 'webp',
})
const ogImage = post.data.heroImage
  ? new URL(post.data.heroImage, site).href
  : new URL(optimizedOg.src, site).href

const jsonLd = blogPostingJsonLd({
  siteUrl: site,
  title: post.data.title,
  description: post.data.description,
  url: shareUrl,
  datePublished: post.data.pubDate,
  dateModified: modifiedDate,
  author,
  image: ogImage,
})
---

<BlogPageLayout
  title={post.data.title}
  description={post.data.description}
  ogImage={ogImage}
  ogType="article"
  publishedTime={post.data.pubDate}
  modifiedTime={modifiedDate}
  author={author}
>
  <script
    slot="head"
    type="application/ld+json"
    set:html={JSON.stringify(jsonLd)}
  />
  <Fragment slot="header">
    <nav aria-label="Breadcrumb" class="text-muted-foreground mb-4 text-sm">
      <ol class="flex flex-wrap items-center gap-2">
        <li>
          <a href="/" class="hover:text-primary transition-colors">Home</a>
        </li>
        <li aria-hidden="true">›</li>
        <li>
          <a href="/blog/" class="hover:text-primary transition-colors"
            >Journal</a
          >
        </li>
        <li aria-hidden="true">›</li>
        <li class="text-foreground" aria-current="page">{post.data.title}</li>
      </ol>
    </nav>
    <div class="flex items-start justify-between gap-4 border-b pb-2">
      <h1 class="scroll-m-20 text-3xl font-semibold tracking-tight first:mt-0">
        {post.data.title}
      </h1>
      <div class="shrink-0 pt-1">
        <ShareMenu client:idle title={post.data.title} url={shareUrl} />
      </div>
    </div>
    <div
      class="text-muted-foreground mt-4 flex flex-wrap items-center gap-3 text-sm"
    >
      <span>{author}</span>
      <span aria-hidden="true">·</span>
      <time datetime={post.data.pubDate.toISOString()}>
        {
          post.data.pubDate.toLocaleDateString('en-US', {
            year: 'numeric',
            month: 'long',
            day: 'numeric',
          })
        }
      </time>
      <span aria-hidden="true">·</span>
      <span>{formatReadingTime(readingTime)}</span>
      {
        post.data.updatedDate && (
          <>
            <span aria-hidden="true">·</span>
            <span>
              Updated{' '}
              {post.data.updatedDate.toLocaleDateString('en-US', {
                year: 'numeric',
                month: 'long',
                day: 'numeric',
              })}
            </span>
          </>
        )
      }
    </div>
    {
      post.data.tags.length > 0 && (
        <div class="mt-3 flex flex-wrap gap-2">
          {post.data.tags.map((tag) => (
            <a
              href={`/blog/tags/${slugifyTag(tag)}/`}
              class="bg-secondary text-secondary-foreground hover:bg-primary/10 hover:text-primary rounded-md px-2 py-0.5 text-xs transition-colors"
            >
              {tag}
            </a>
          ))}
        </div>
      )
    }
  </Fragment>
  {
    toc.length > 0 && (
      <div class="mb-8 lg:hidden">
        <TOCInline client:visible items={toc} />
      </div>
    )
  }
  <article class="prose dark:prose-invert max-w-none">
    <Content />
  </article>
  {
    toc.length > 0 && (
      <aside
        class="pointer-events-none fixed inset-y-0 right-3 z-40 hidden items-center sm:right-6 lg:flex xl:right-10"
        aria-label="Table of contents"
      >
        <div class="pointer-events-auto">
          <TOCMinimap client:idle items={toc} />
        </div>
      </aside>
    )
  }
  <Toaster client:idle />
</BlogPageLayout>
