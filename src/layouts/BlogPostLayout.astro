---
import { render } from 'astro:content'
import type { CollectionEntry } from 'astro:content'
import BlogPageLayout from './BlogPageLayout.astro'
import { SITE } from '../lib/constants'

interface Props {
  post: CollectionEntry<'blog'>
}

const { post } = Astro.props
const { Content } = await render(post)
const author = post.data.author ?? SITE.AUTHOR
const modifiedDate = post.data.updatedDate ?? post.data.pubDate

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: post.data.title,
  description: post.data.description,
  datePublished: post.data.pubDate.toISOString(),
  dateModified: modifiedDate.toISOString(),
  author: {
    '@type': 'Person',
    name: author,
  },
  mainEntityOfPage: {
    '@type': 'WebPage',
    '@id': new URL(`/blog/${post.id}/`, Astro.site).href,
  },
}
---

<BlogPageLayout
  title={post.data.title}
  description={post.data.description}
  ogType="article"
  publishedTime={post.data.pubDate}
  modifiedTime={modifiedDate}
  author={author}
>
  <script
    slot="head"
    type="application/ld+json"
    set:html={JSON.stringify(jsonLd)}
  />
  <Fragment slot="header">
    <a
      href="/blog/"
      class="text-muted-foreground hover:text-primary mb-4 inline-block text-sm"
    >
      ← Blog
    </a>
    <h1
      class="scroll-m-20 border-b pb-2 text-3xl font-semibold tracking-tight first:mt-0"
    >
      {post.data.title}
    </h1>
    <div
      class="text-muted-foreground mt-4 flex flex-wrap items-center gap-3 text-sm"
    >
      <span>{author}</span>
      <span aria-hidden="true">·</span>
      <time datetime={post.data.pubDate.toISOString()}>
        {
          post.data.pubDate.toLocaleDateString('en-US', {
            year: 'numeric',
            month: 'long',
            day: 'numeric',
          })
        }
      </time>
      {
        post.data.updatedDate && (
          <>
            <span aria-hidden="true">·</span>
            <span>
              Updated{' '}
              {post.data.updatedDate.toLocaleDateString('en-US', {
                year: 'numeric',
                month: 'long',
                day: 'numeric',
              })}
            </span>
          </>
        )
      }
    </div>
    {
      post.data.tags.length > 0 && (
        <div class="mt-3 flex flex-wrap gap-2">
          {post.data.tags.map((tag) => (
            <span class="text-muted-foreground text-xs">#{tag}</span>
          ))}
        </div>
      )
    }
  </Fragment>
  <article class="prose dark:prose-invert max-w-none">
    <Content />
  </article>
</BlogPageLayout>
