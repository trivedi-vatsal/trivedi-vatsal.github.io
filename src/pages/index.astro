---
import { getCollection } from 'astro:content'
import BaseLayout from '../layouts/BaseLayout.astro'
import IdentityTile from '../components/bento/IdentityTile.astro'
import NowTile from '../components/bento/NowTile.astro'
import WorkTile from '../components/bento/WorkTile.astro'
import BuildingTile from '../components/bento/BuildingTile.astro'
import ExperimentsTile from '../components/bento/ExperimentsTile.astro'
import FeaturedTile from '../components/bento/FeaturedTile.astro'
import AISuiteTile from '../components/bento/AISuiteTile.astro'
import NotesTile from '../components/bento/NotesTile.astro'
import LifeTile from '../components/bento/LifeTile.astro'
import BuildLogTile from '../components/bento/BuildLogTile.astro'
import ContactTile from '../components/bento/ContactTile.astro'
import { StackTile } from '../components/bento/StackTile'
import { STACK, buildLogFromContent } from '../lib/portfolio'
import {
  isListedPost,
  getFeaturedJournal,
  toBlogPostSummary,
} from '../lib/blog'
import { SITE } from '../lib/constants'

const posts = (await getCollection('blog', isListedPost))
  .map(toBlogPostSummary)
  .sort((a, b) => new Date(b.pubDate).valueOf() - new Date(a.pubDate).valueOf())

const latest = getFeaturedJournal(posts)
const buildLog = buildLogFromContent(posts)
---

<BaseLayout
  title="Vatsal Trivedi"
  description={SITE.DESCRIPTION}
  useTitleTemplate={false}
>
  <main
    class="relative mx-auto w-full max-w-6xl px-3 py-4 sm:px-4 sm:py-6 md:px-6 lg:py-8"
  >
    <div class="bento-grid home-bento">
      <IdentityTile />
      <NowTile />
      <FeaturedTile />
      <BuildingTile />
      <ExperimentsTile />
      <StackTile client:visible items={STACK} />
      <AISuiteTile />
      {
        latest ? (
          <NotesTile
            title={latest.title}
            description={latest.description}
            href={latest.href}
            tags={latest.tags}
            pubDate={latest.pubDate}
            readingTime={latest.readingTime}
            action={latest.isSeries ? 'Read series' : 'Read note'}
          />
        ) : (
          <NotesTile
            title="Journal coming soon"
            description="No posts yet. Check back soon."
            href="/blog/"
            tags={['AI', 'Engineering', 'Design']}
            pubDate={new Date().toISOString()}
            readingTime={1}
          />
        )
      }
      <LifeTile />
      <WorkTile />
      <BuildLogTile entries={buildLog} />
      <ContactTile />
    </div>
  </main>
</BaseLayout>

<style>
  .home-bento {
    gap: 16px;
  }
  .home-bento :global(.bento-tile) {
    border-radius: var(--tile-radius);
    box-shadow: 0 3px 8px hsl(var(--foreground) / 0.015);
  }
  .home-bento :global(.bento-tile:hover) {
    transform: translateY(-3px);
    box-shadow: 0 14px 36px -20px hsl(var(--foreground) / 0.28);
  }
  .home-bento :global(.now-tile) {
    background: hsl(var(--secondary) / 0.55);
  }
  @media (min-width: 1024px) {
    .home-bento :global(.featured-tile) {
      order: 3;
      grid-column: span 7;
    }
    .home-bento :global([aria-label='Currently building']) {
      order: 4;
      grid-column: span 5;
      padding-bottom: 110px;
    }
    .home-bento :global([aria-label='Experiments']) {
      order: 5;
      grid-column: span 3;
    }
    .home-bento :global([aria-label='My stack']) {
      order: 6;
      grid-column: span 3;
    }
    .home-bento :global([aria-label='Selected work']) {
      order: 7;
      grid-column: span 3;
    }
    .home-bento :global([aria-label='AI subscription suite']) {
      order: 8;
      grid-column: span 3;
    }
    .home-bento :global([aria-label^='Journal:']) {
      order: 9;
      grid-column: span 7;
    }
    .home-bento :global([aria-label='Life outside code']) {
      order: 10;
      grid-column: span 5;
    }
    .home-bento :global([aria-label='Build log']) {
      order: 11;
      grid-column: span 6;
    }
    .home-bento :global(#contact) {
      order: 12;
      grid-column: span 6;
    }
  }
  @media (max-width: 639px) {
    .home-bento {
      gap: 12px;
    }
    .home-bento :global([aria-label='Currently building']) {
      padding-bottom: 110px;
    }
  }
</style>
