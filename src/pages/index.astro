---
import { getCollection } from 'astro:content'
import BaseLayout from '../layouts/BaseLayout.astro'
import IdentityTile from '../components/bento/IdentityTile.astro'
import NowTile from '../components/bento/NowTile.astro'
import WorkTile from '../components/bento/WorkTile.astro'
import BuildingTile from '../components/bento/BuildingTile.astro'
import ExperimentsTile from '../components/bento/ExperimentsTile.astro'
import FeaturedTile from '../components/bento/FeaturedTile.astro'
import NotesTile from '../components/bento/NotesTile.astro'
import LifeTile from '../components/bento/LifeTile.astro'
import BuildLogTile from '../components/bento/BuildLogTile.astro'
import ContactTile from '../components/bento/ContactTile.astro'
import { StackTile } from '../components/bento/StackTile'
import { STACK, buildLogFromContent } from '../lib/portfolio'
import { toBlogPostSummary } from '../lib/blog'
import { SITE } from '../lib/constants'

const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .map(toBlogPostSummary)
  .sort((a, b) => new Date(b.pubDate).valueOf() - new Date(a.pubDate).valueOf())

const latest = posts[0]
const buildLog = buildLogFromContent(posts)
---

<BaseLayout
  title="Vatsal Trivedi"
  description={SITE.DESCRIPTION}
  useTitleTemplate={false}
>
  <main
    class="relative mx-auto w-full max-w-6xl px-3 py-4 sm:px-4 sm:py-6 md:px-6 lg:py-8"
  >
    <div class="bento-grid">
      <IdentityTile />
      <NowTile />
      <FeaturedTile />
      <BuildingTile />
      <ExperimentsTile />
      <StackTile client:visible items={STACK} />
      {
        latest ? (
          <NotesTile
            title={latest.title}
            description={latest.description}
            href={latest.href}
            tags={latest.tags}
            pubDate={latest.pubDate}
            readingTime={latest.readingTime}
          />
        ) : (
          <NotesTile
            title="Journal coming soon"
            description="Thinking, documented. First entry is on the way."
            href="/blog/"
            tags={['AI', 'Engineering', 'Design']}
            pubDate={new Date().toISOString()}
            readingTime={1}
          />
        )
      }
      <LifeTile />
      <WorkTile />
      <BuildLogTile entries={buildLog} />
      <ContactTile />
    </div>
  </main>
</BaseLayout>
