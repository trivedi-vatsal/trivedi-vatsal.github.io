---
import { getCollection } from 'astro:content'
import BlogPageLayout from '../../../layouts/BlogPageLayout.astro'
import { BlogExplorer } from '../../../components/blog/BlogExplorer'
import { getAllTags, slugifyTag, toBlogPostSummary } from '../../../lib/blog'

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => !data.draft)
  const summaries = posts.map(toBlogPostSummary)
  const tags = getAllTags(summaries)

  return tags.map(({ tag, slug }) => ({
    params: { tag: slug },
    props: { tag, slug },
  }))
}

interface Props {
  tag: string
  slug: string
}

const { tag, slug } = Astro.props

const allPosts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .map(toBlogPostSummary)

const posts = allPosts.filter((post) =>
  post.tags.some(
    (t) => slugifyTag(t) === slug || t.toLowerCase() === tag.toLowerCase(),
  ),
)

const title = tag
const description = `Articles about ${tag}`
---

<BlogPageLayout title={title} description={description}>
  <Fragment slot="header">
    <nav aria-label="Breadcrumb" class="text-muted-foreground mb-4 text-sm">
      <ol class="flex flex-wrap items-center gap-2">
        <li>
          <a href="/" class="hover:text-primary transition-colors">Home</a>
        </li>
        <li aria-hidden="true">›</li>
        <li>
          <a href="/blog/" class="hover:text-primary transition-colors"
            >Journal</a
          >
        </li>
        <li aria-hidden="true">›</li>
        <li class="text-foreground capitalize" aria-current="page">{tag}</li>
      </ol>
    </nav>
    <h1
      class="scroll-m-20 border-b pb-2 text-3xl font-semibold tracking-tight capitalize first:mt-0"
    >
      {tag}
    </h1>
    <p class="text-muted-foreground mt-4">{description}</p>
  </Fragment>

  <BlogExplorer client:load posts={posts} initialTag={slug} hideViewToggle />
</BlogPageLayout>
