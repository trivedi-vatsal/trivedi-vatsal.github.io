---
import { getCollection } from 'astro:content'
import { BLOG } from '../../lib/constants'
import { toBlogPostSummary } from '../../lib/blog'
import BlogPageLayout from '../../layouts/BlogPageLayout.astro'
import { BlogExplorer } from '../../components/blog/BlogExplorer'

const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .map(toBlogPostSummary)
---

<BlogPageLayout title={BLOG.TITLE} description={BLOG.DESCRIPTION}>
  <Fragment slot="header">
    <nav aria-label="Breadcrumb" class="text-muted-foreground mb-4 text-sm">
      <ol class="flex flex-wrap items-center gap-2">
        <li>
          <a href="/" class="hover:text-primary transition-colors">Home</a>
        </li>
        <li aria-hidden="true">›</li>
        <li class="text-foreground" aria-current="page">Notes</li>
      </ol>
    </nav>
    <h1
      class="scroll-m-20 border-b pb-2 text-3xl font-semibold tracking-tight first:mt-0"
    >
      {BLOG.TITLE}
    </h1>
    <p class="text-muted-foreground mt-4">{BLOG.DESCRIPTION}</p>
  </Fragment>

  <BlogExplorer client:load posts={posts} />
</BlogPageLayout>
