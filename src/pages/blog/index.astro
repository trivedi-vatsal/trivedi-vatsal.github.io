---
import { getCollection } from 'astro:content'
import { BLOG } from '../../lib/constants'
import BlogPageLayout from '../../layouts/BlogPageLayout.astro'

const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
)
---

<BlogPageLayout title={BLOG.TITLE} description={BLOG.DESCRIPTION}>
  <Fragment slot="header">
    <h1
      class="scroll-m-20 border-b pb-2 text-3xl font-semibold tracking-tight first:mt-0"
    >
      {BLOG.TITLE}
    </h1>
    <p class="text-muted-foreground mt-4">{BLOG.DESCRIPTION}</p>
  </Fragment>
  {
    posts.length === 0 ? (
      <p class="text-muted-foreground">
        No posts yet. Check back soon for writing on engineering, integrations,
        and building thoughtful products.
      </p>
    ) : (
      <ul>
        {posts.map((post) => (
          <li class="animate mt-4 border-b border-black/10 py-8 first-of-type:mt-0 first-of-type:pt-0 last-of-type:border-none dark:border-white/25">
            <div class="mb-4 text-sm uppercase">
              {post.data.pubDate.toLocaleDateString('en-US', {
                year: 'numeric',
                month: 'short',
                day: 'numeric',
              })}
            </div>
            <a href={`/blog/${post.id}/`} class="text-primary font-semibold">
              {post.data.title}
            </a>
            <p class="text-muted-foreground mt-2 text-sm">
              {post.data.description}
            </p>
            {post.data.tags.length > 0 && (
              <div class="mt-3 flex flex-wrap gap-2">
                {post.data.tags.map((tag) => (
                  <span class="text-muted-foreground text-xs">#{tag}</span>
                ))}
              </div>
            )}
          </li>
        ))}
      </ul>
    )
  }
</BlogPageLayout>
