---
import { WORK } from '../lib/constants'
import BaseLayout from '../layouts/BaseLayout.astro'
import TopLayout from '../layouts/TopLayout.astro'
import BottomLayout from '../layouts/BottomLayout.astro'
import { EXPERIENCE } from '../lib/constants'
---

<BaseLayout title={WORK.TITLE} description={WORK.DESCRIPTION}>
  <main class="flex min-h-[80vh] flex-auto flex-col" transition:animate="fade">
    <TopLayout>
      <p class="bento-label mb-3">Career</p>
      <h1 class="scroll-m-20 text-3xl font-semibold tracking-tight sm:text-4xl">
        {WORK.TITLE}
      </h1>
      <p class="text-muted-foreground mt-3 max-w-2xl text-base">
        Places I have built. AI platforms, enterprise SaaS, and integration-heavy
        systems.
      </p>
    </TopLayout>
    <BottomLayout>
      <ol class="relative">
        <div
          class="bg-border absolute top-8 bottom-8 left-[4px] w-px sm:top-10 sm:bottom-10"
          aria-hidden="true"
        >
        </div>
        {
          EXPERIENCE.map((entry) => (
            <li class="relative py-8 pl-8 sm:py-10 sm:pl-10">
              {entry.current ? (
                <span
                  class="status-dot status-dot--primary absolute top-8 left-0 sm:top-10"
                  aria-hidden="true"
                />
              ) : (
                <span
                  class="border-border bg-background absolute top-8 left-0 h-2.5 w-2.5 rounded-full border sm:top-10"
                  aria-hidden="true"
                />
              )}
              {entry.current && <span class="sr-only">Current</span>}
              <div class="text-muted-foreground font-mono text-[0.7rem] tracking-[0.12em] uppercase">
                {entry.start} - {entry.end}
              </div>
              <div class="mt-2 flex flex-wrap items-baseline gap-x-3 gap-y-1">
                {entry.link ? (
                  <a
                    href={entry.link}
                    class="text-primary focus-visible:ring-ring text-xl font-semibold tracking-tight hover:underline focus-visible:ring-2 focus-visible:outline-none"
                    target="_blank"
                    rel="noopener noreferrer"
                  >
                    {entry.company}
                  </a>
                ) : (
                  <span class="text-xl font-semibold tracking-tight">
                    {entry.company}
                  </span>
                )}
                <span class="text-muted-foreground text-sm">
                  {entry.position}
                </span>
              </div>
              <p class="text-muted-foreground mt-1 font-mono text-xs tracking-wide">
                {entry.location}
              </p>
              <ul class="mt-4 max-w-3xl space-y-2">
                {entry.tasks.map((task) => (
                  <li class="text-foreground/85 text-sm leading-relaxed">
                    <span aria-hidden="true">▸ </span>
                    {task}
                  </li>
                ))}
              </ul>
              {entry.stack && entry.stack.length > 0 && (
                <ul class="text-muted-foreground mt-4 flex max-w-3xl flex-wrap gap-x-3 gap-y-1.5 font-mono text-[0.65rem] tracking-wide">
                  {entry.stack.map((item) => (
                    <li>{item}</li>
                  ))}
                </ul>
              )}
            </li>
          ))
        }
      </ol>
    </BottomLayout>
  </main>
</BaseLayout>
