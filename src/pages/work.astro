---
import { WORK, WORK_EXPERIENCES } from '../lib/constants'
import BaseLayout from '../layouts/BaseLayout.astro'
import TopLayout from '../layouts/TopLayout.astro'
import BottomLayout from '../layouts/BottomLayout.astro'
import { WorkExperience } from '../components/work-experience'
---

<BaseLayout title={WORK.TITLE} description={WORK.DESCRIPTION}>
  <main class="flex min-h-[calc(100dvh-8rem)] flex-auto flex-col" transition:animate="fade">
    <TopLayout>
      <h1 class="scroll-m-20 text-3xl font-semibold tracking-tight sm:text-4xl">
        {WORK.TITLE}
      </h1>
      <p class="text-muted-foreground mt-3 max-w-2xl text-base">
        Phamax, Comviva, and TCS. AI platforms, enterprise SaaS, and
        integration-heavy systems.
      </p>
    </TopLayout>
    <BottomLayout>
      <WorkExperience
        client:visible
        className="bg-transparent px-0"
        experiences={WORK_EXPERIENCES}
      />
    </BottomLayout>
  </main>
</BaseLayout>
