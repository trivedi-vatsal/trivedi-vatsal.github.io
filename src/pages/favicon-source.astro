---
import '@/styles/globals.css'
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="robots" content="noindex" />
    <title>Favicon source</title>
  </head>
  <body>
    <div class="mark" id="favicon-mark">
      <img src="/me.svg" alt="" />
    </div>
  </body>
</html>

<style is:global>
  html,
  body {
    margin: 0;
    width: 512px;
    height: 512px;
    overflow: hidden;
    background: #f6f3ef;
  }

  .mark {
    width: 512px;
    height: 512px;
    overflow: hidden;
    background: #f6f3ef;
  }

  img {
    display: block;
    width: 168%;
    margin-left: -34%;
    margin-top: -8%;
    filter: contrast(1.22);
  }
</style>
