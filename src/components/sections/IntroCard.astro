---
import { Image } from 'astro:assets'
import Card from '../Card.astro'
import { Button } from '../ui/button'
import { LINKS } from '../../lib/constants'
import { Linkedin, Github, Mail, Globe } from 'lucide-react'
import me from '../../assets/images/me.jpg'
---

<Card colSpan="md:col-span-3" rowSpan="md:row-span-4">
  <div class="flex h-full w-full">
    <div class="flex flex-col justify-between gap-4 md:max-h-[300px]">
      <div class="flex h-full flex-col">
        <h6 class="m-0 text-sm font-light text-gray-500">Welcome</h6>
        <h1 class="m-0 text-xl font-light">
          Hi, I'm <b class="font-bold">Vatsal Trivedi</b>, <br />a Full Spectrum
          Engineer who believes in building technology that matters.
        </h1>
        <p class="m-0 mt-4 text-xl font-light">
          I transform complex business challenges into elegant digital
          solutions. With a passion for clean code, thoughtful architecture, and
          user-centered design, I craft experiences that make technology feel
          effortless and intuitive.
        </p>
      </div>
      <div class="flex gap-4">
        <a
          href={LINKS.resume}
          aria-label="Resume"
          target="_blank"
          rel="noopener noreferrer"
        >
          <Button aria-label="Resume">
            <Globe />
            <span class="sr-only">Resume</span>
          </Button>
        </a>
        <a
          href={LINKS.github}
          aria-label="GitHub profile"
          target="_blank"
          rel="noopener noreferrer"
        >
          <Button aria-label="GitHub profile">
            <Github />
            <span class="sr-only">GitHub Profile</span>
          </Button>
        </a>
        <a
          href={LINKS.linkedin}
          aria-label="LinkedIn profile"
          target="_blank"
          rel="noopener noreferrer"
        >
          <Button aria-label="LinkedIn profile">
            <Linkedin />
            <span class="sr-only">Linkedin Profile</span>
          </Button>
        </a>
        <a href={LINKS.mail} aria-label="Email contact">
          <Button>
            <Mail />
            <span class="sr-only">Email contact</span>
          </Button>
        </a>
      </div>
    </div>
    <Image
      src={me}
      alt="Portrait of Vatsal Trivedi"
      width={300}
      height={300}
      widths={[150, 300]}
      sizes="(max-width: 768px) 150px, 300px"
      loading="eager"
      class="pointer-events-none absolute right-[-110px] bottom-[-20px] z-[-1] max-h-[300px] w-auto opacity-50 select-none md:relative md:right-auto md:bottom-auto md:z-auto md:opacity-100"
    />
  </div>
</Card>
