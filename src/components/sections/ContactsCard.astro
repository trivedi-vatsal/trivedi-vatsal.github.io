---
import Card from '../Card.astro'
import { LINKS } from '../../lib/constants'
---

<Card colSpan="md:col-span-1" rowSpan="md:row-span-4">
  <div class="h-full">
    <header class="flex items-center">
      <h2 class="text-foreground text-xl font-bold">
        Let's start working together!
      </h2>
    </header>
    <address class="mt-4 flex flex-col not-italic">
      <h3 class="text-gray-500">Contact Details</h3>
      <p>trivedivatsal005@gmail.com</p>
      <p>Bengaluru, India</p>
    </address>
    <div class="mt-4 flex w-fit flex-col">
      <h3 class="text-gray-500">Socials</h3>
      <ul>
        <li>
          <a href={LINKS.linkedin} target="_blank" rel="noopener noreferrer"
            >Linkedin</a
          >
        </li>
        <li>
          <a href={LINKS.github} target="_blank" rel="noopener noreferrer"
            >Github</a
          >
        </li>
        <li>
          <a href={LINKS.instagram} target="_blank" rel="noopener noreferrer"
            >Instagram</a
          >
        </li>
        <li>
          <a href={LINKS.dribbble} target="_blank" rel="noopener noreferrer"
            >Dribbble</a
          >
        </li>
        <li>
          <a href={LINKS.behance} target="_blank" rel="noopener noreferrer"
            >Behance</a
          >
        </li>
        <li>
          <a href={LINKS.devto} target="_blank" rel="noopener noreferrer"
            >Dev.to</a
          >
        </li>
      </ul>
    </div>
  </div>
</Card>
