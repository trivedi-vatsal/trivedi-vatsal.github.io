---
import BentoTile from './BentoTile.astro'
import { EXPERIMENTS } from '../../lib/portfolio'
---

<BentoTile
  href="/experiments/"
  class="order-5 col-span-1 flex min-h-[220px] flex-col justify-between p-5 sm:p-6 lg:order-5 lg:col-span-4"
  radius="soft"
  delay={140}
  ariaLabel="Experiments"
>
  <div>
    <p class="bento-label">Experiments</p>
    <div class="relative mt-4 h-[9.5rem] overflow-hidden">
      <div
        class="from-card pointer-events-none absolute inset-x-0 top-0 z-10 h-4 bg-gradient-to-b to-transparent"
      >
      </div>
      <div
        class="from-card pointer-events-none absolute inset-x-0 bottom-0 z-10 h-4 bg-gradient-to-t to-transparent"
      >
      </div>
      <ul class="anim-marquee-y space-y-0">
        {
          [...EXPERIMENTS, ...EXPERIMENTS].map((item, i) => (
            <li
              class="border-border/70 group-hover:border-foreground/15 flex items-baseline justify-between gap-3 border-b py-2.5 transition-colors"
              style={`transition-delay: ${(i % EXPERIMENTS.length) * 40}ms`}
            >
              <span class="text-sm font-medium tracking-tight sm:text-base">
                {item.title}
              </span>
              <span class="text-muted-foreground font-mono text-[0.6rem] opacity-0 transition-opacity group-hover:opacity-100">
                {item.external ? '↗' : '→'}
              </span>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
  <span class="bento-arrow text-foreground mt-4">
    Browse experiments
    <span aria-hidden="true">→</span>
  </span>
</BentoTile>
