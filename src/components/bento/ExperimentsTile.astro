---
import BentoTile from './BentoTile.astro'
import { EXPERIMENTS } from '../../lib/portfolio'
---

<BentoTile
  href="/experiments/"
  class="order-5 col-span-1 flex min-h-[220px] flex-col justify-between p-5 sm:p-6 lg:order-5 lg:col-span-4"
  radius="flat"
  delay={140}
  ariaLabel="Experiments"
>
  <div>
    <p class="bento-label">Experiments</p>
    <ul class="mt-4 space-y-0">
      {
        EXPERIMENTS.map((item, i) => (
          <li
            class="border-border/70 flex items-baseline justify-between gap-3 border-b py-2.5 last:border-b-0 transition-colors group-hover:border-foreground/15"
            style={`transition-delay: ${i * 40}ms`}
          >
            <span class="text-sm font-medium tracking-tight sm:text-base">
              {item.title}
            </span>
            <span class="font-mono text-[0.6rem] text-muted-foreground opacity-0 transition-opacity group-hover:opacity-100">
              {item.external ? '↗' : '→'}
            </span>
          </li>
        ))
      }
    </ul>
  </div>
  <span class="bento-arrow mt-4 text-foreground">
    Browse experiments
    <span aria-hidden="true">→</span>
  </span>
</BentoTile>
