---
import BentoTile from './BentoTile.astro'
import { EXPERIMENTS } from '../../lib/portfolio'

const accents = [
  'bg-primary/80',
  'bg-foreground/35',
  'bg-primary/50',
  'bg-foreground/25',
]
---

<BentoTile
  href="/experiments/"
  class="order-5 col-span-1 flex min-h-[220px] flex-col justify-between p-5 sm:p-6 lg:order-5 lg:col-span-4"
  radius="soft"
  delay={140}
  ariaLabel="Experiments"
>
  <div>
    <h2 class="text-base font-semibold tracking-tight bento-wake bento-wake-title">
      Experiments
    </h2>
    <div class="relative mt-4 h-[9.5rem] overflow-hidden">
      <div
        class="from-card pointer-events-none absolute inset-x-0 top-0 z-10 h-4 bg-gradient-to-b to-transparent"
      >
      </div>
      <div
        class="from-card pointer-events-none absolute inset-x-0 bottom-0 z-10 h-4 bg-gradient-to-t to-transparent"
      >
      </div>
      <ul class="anim-marquee-y space-y-0">
        {
          [...EXPERIMENTS, ...EXPERIMENTS].map((item, i) => (
            <li
              class="border-border/70 group-hover:border-foreground/15 flex items-center justify-between gap-3 border-b py-2.5 transition-colors"
              style={`transition-delay: ${(i % EXPERIMENTS.length) * 40}ms`}
            >
              <span class="flex min-w-0 items-center gap-2.5">
                <span
                  class:list={[
                    'inline-flex size-6 shrink-0 items-center justify-center rounded-md border border-border/60 bg-secondary/50',
                  ]}
                  aria-hidden="true"
                >
                  <span
                    class:list={[
                      'size-2 rounded-[2px]',
                      accents[i % accents.length],
                    ]}
                  />
                </span>
                <span class="truncate text-sm font-medium tracking-tight sm:text-base">
                  {item.title}
                </span>
              </span>
              <span class="text-muted-foreground font-mono text-[0.6rem] opacity-0 transition-opacity group-hover:opacity-100">
                {item.kind}
              </span>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
  <span
    class="bento-arrow text-foreground mt-4 bento-wake bento-wake-x"
    style="--wake-delay: 60ms"
  >
    Browse experiments
    <span aria-hidden="true">→</span>
  </span>
</BentoTile>
