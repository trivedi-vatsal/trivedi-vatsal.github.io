---
import BentoTile from './BentoTile.astro'
import { NOW } from '../../lib/portfolio'
---

<BentoTile
  class="order-2 col-span-1 flex min-h-[240px] flex-col justify-between p-5 sm:p-6 lg:col-span-5 lg:row-span-2"
  radius="soft"
  delay={60}
  ariaLabel="Now"
>
  <div class="flex items-start justify-between gap-3">
    <div>
      <p class="bento-label">Now</p>
      <p class="text-muted-foreground mt-2 text-sm">{NOW.role}</p>
    </div>
    <span class="status-dot mt-1" aria-hidden="true"></span>
  </div>

  <div class="mt-6 space-y-5">
    <div>
      <p
        class="text-muted-foreground font-mono text-[0.65rem] tracking-[0.14em] uppercase"
      >
        Building
      </p>
      <p class="mt-1.5 text-sm leading-relaxed sm:text-base">{NOW.building}</p>
    </div>
    <div>
      <p
        class="text-muted-foreground font-mono text-[0.65rem] tracking-[0.14em] uppercase"
      >
        Exploring
      </p>
      <ul class="mt-2 flex flex-wrap gap-2">
        {
          NOW.exploring.map((item, i) => (
            <li
              class:list={[
                'anim-tag rounded-sm border px-2 py-1 font-mono text-[0.65rem] tracking-wide',
                i === 1 && 'anim-tag-delay-1',
                i === 2 && 'anim-tag-delay-2',
              ]}
            >
              {item}
            </li>
          ))
        }
      </ul>
    </div>
  </div>

  <p class="text-muted-foreground mt-6 font-mono text-[0.65rem] tracking-wide">
    Last updated · {NOW.updatedLabel}
  </p>
</BentoTile>
