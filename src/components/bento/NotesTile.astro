---
import BentoTile from './BentoTile.astro'
import { formatPostDate, formatReadingTime } from '../../lib/blog'

interface Props {
  title: string
  description: string
  href: string
  tags: string[]
  pubDate: string
  readingTime: number
}

const { title, description, href, tags, pubDate, readingTime } = Astro.props
---

<BentoTile
  href={href}
  class="order-7 col-span-1 flex min-h-[240px] flex-col justify-between p-5 sm:p-6 lg:order-8 lg:col-span-5"
  radius="default"
  delay={200}
  ariaLabel={`Journal: ${title}`}
>
  <div>
    <p class="bento-label">Journal</p>
    <p class="text-muted-foreground mt-2 font-mono text-xs tracking-wide">
      Thinking, documented.
    </p>
    <h2
      class="anim-shimmer-text mt-4 text-2xl leading-tight font-semibold tracking-tight sm:text-3xl"
    >
      {title}
    </h2>
    <p class="text-muted-foreground mt-3 line-clamp-2 text-sm leading-relaxed">
      {description}
    </p>
  </div>

  <div
    class="border-border/80 mt-6 flex flex-wrap items-end justify-between gap-3 border-t pt-4"
  >
    <div>
      <p class="text-muted-foreground font-mono text-[0.65rem] tracking-wide">
        {tags.length ? tags.map((t) => t).join(' · ') : 'Journal'}
      </p>
      <p class="text-muted-foreground mt-1 font-mono text-[0.65rem]">
        {formatPostDate(pubDate)} · {formatReadingTime(readingTime)}
      </p>
    </div>
    <span class="bento-arrow text-foreground">
      Read note
      <span aria-hidden="true">→</span>
    </span>
  </div>
</BentoTile>
