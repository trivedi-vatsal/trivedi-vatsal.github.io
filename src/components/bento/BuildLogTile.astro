---
import BentoTile from './BentoTile.astro'
import type { BuildLogEntry } from '../../lib/portfolio'

interface Props {
  entries: BuildLogEntry[]
}

const { entries } = Astro.props
---

<BentoTile
  class="order-10 col-span-1 flex min-h-[220px] flex-col p-5 sm:p-6 lg:order-10 lg:col-span-3"
  radius="soft"
  delay={240}
  ariaLabel="Build log"
>
  <p class="bento-label">Build log</p>
  {
    entries.length === 0 ? (
      <p class="text-muted-foreground mt-4 text-sm">No dated entries yet.</p>
    ) : (
      <ol class="build-timeline mt-4">
        {entries.map((entry) => (
          <li class="build-entry">
            <time class="text-muted-foreground font-mono text-[0.65rem] tracking-wide">
              {entry.date}
            </time>
            {entry.href ? (
              <a
                href={entry.href}
                class="hover:text-primary text-sm font-medium transition-colors"
              >
                {entry.label}
              </a>
            ) : (
              <span class="text-sm font-medium">{entry.label}</span>
            )}
          </li>
        ))}
      </ol>
    )
  }
</BentoTile>

<style>
  .build-entry {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding: 0 0 20px 22px;
  }
  .build-entry::before {
    content: '';
    position: absolute;
    left: 4px;
    top: 8px;
    bottom: -8px;
    width: 1px;
    background: hsl(var(--border));
  }
  .build-entry::after {
    content: '';
    position: absolute;
    left: 1px;
    top: 5px;
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: hsl(var(--primary));
  }
  .build-entry:last-child {
    padding-bottom: 0;
  }
  .build-entry:last-child::before {
    display: none;
  }
  .build-entry time {
    line-height: 16px;
  }
  .build-entry a,
  .build-entry > span {
    line-height: 1.5;
  }
</style>
