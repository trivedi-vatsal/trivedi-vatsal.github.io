---
import BentoTile from './BentoTile.astro'
import { FEATURED } from '../../lib/portfolio'
---

<BentoTile
  href={FEATURED.href}
  class="order-3 col-span-1 flex min-h-[320px] flex-col overflow-hidden sm:col-span-2 lg:order-6 lg:col-span-8 lg:min-h-[380px]"
  radius="soft"
  delay={160}
  ariaLabel={`Featured project: ${FEATURED.name}`}
>
  <!-- Dominant visual plane -->
  <div
    class="bg-foreground/[0.03] dark:bg-foreground/[0.05] relative min-h-[180px] flex-1 overflow-hidden"
  >
    <div class="generative-grid absolute inset-0"></div>
    <div
      class="from-primary/15 absolute inset-0 bg-gradient-to-br via-transparent to-transparent transition-transform duration-700 group-hover:scale-105"
    >
    </div>
    <div
      class="border-primary/30 absolute top-1/2 -right-10 h-56 w-56 -translate-y-1/2 rounded-full border transition-transform duration-700 group-hover:scale-110"
      aria-hidden="true"
    >
    </div>
    <div
      class="border-foreground/20 absolute top-1/2 right-8 h-36 w-36 -translate-y-1/2 rounded-full border border-dashed"
      aria-hidden="true"
    >
    </div>
    <div class="absolute inset-0 flex items-end p-6 sm:p-8">
      <div>
        <p class="bento-label text-foreground/60">Featured project</p>
        <h2
          class="mt-2 max-w-lg text-3xl font-semibold tracking-tight sm:text-4xl"
        >
          {FEATURED.name}
        </h2>
        <p
          class="text-muted-foreground mt-1 font-mono text-[0.65rem] tracking-[0.12em] uppercase opacity-0 transition-opacity duration-300 group-hover:opacity-100"
        >
          {FEATURED.position} · {FEATURED.period}
        </p>
      </div>
    </div>
  </div>

  <div
    class="flex flex-col gap-4 border-t p-5 sm:flex-row sm:items-end sm:justify-between sm:p-6"
  >
    <div class="max-w-xl">
      <p class="text-muted-foreground text-sm leading-relaxed">
        {FEATURED.description}
      </p>
      <ul class="mt-3 flex flex-wrap gap-2">
        {
          FEATURED.tags.map((tag) => (
            <li class="border-border rounded-sm border px-2 py-0.5 font-mono text-[0.65rem] tracking-wide">
              {tag}
            </li>
          ))
        }
      </ul>
    </div>
    <span class="bento-arrow text-foreground shrink-0">
      Explore
      <span aria-hidden="true">→</span>
    </span>
  </div>
</BentoTile>
