---
import BentoTile from './BentoTile.astro'
import { IDENTITY } from '../../lib/portfolio'
---

<BentoTile
  id="identity"
  class="identity-tile order-1 col-span-1 sm:col-span-2 lg:col-span-8"
  radius="soft"
  as="section"
  ariaLabel="Introduction"
>
  <div class="identity-copy">
    <p class="bento-label">Engineer. Builder. Curious human.</p>
    <h1>Vatsal<br />Trivedi<span>.</span></h1>
    <p class="identity-description">{IDENTITY.statement}</p>
    <div class="identity-actions">
      <a class="work-link" href="/work/"
        >Explore my work <span aria-hidden="true">↗</span></a
      ><a class="about-link" href="/about/"
        >About me <span aria-hidden="true">→</span></a
      >
    </div>
  </div>
  <div class="identity-portrait" aria-hidden="true">
    <div class="portrait-frame-home">
      <img
        src="/me.svg"
        alt=""
        width="1762"
        height="2048"
        fetchpriority="high"
      />
    </div><span>Based in Bengaluru, India ↗</span>
  </div>
  <dl class="identity-meta">
    {
      IDENTITY.meta.map((item) => (
        <div>
          <>
            <dt>{item.value}</dt>
            <dd>{item.label}</dd>
          </>
        </div>
      ))
    }
  </dl>
</BentoTile>

<style>
  .identity-copy {
    position: relative;
    z-index: 1;
    width: 62%;
    padding: 34px 0 28px 34px;
  }
  h1 {
    font-size: clamp(48px, 5.5vw, 72px);
    line-height: 0.98;
    letter-spacing: -0.065em;
    font-weight: 600;
    margin: 25px 0 20px;
  }
  h1 span {
    color: hsl(var(--primary));
  }
  .identity-description {
    color: hsl(var(--muted-foreground));
    font-size: 14px;
    line-height: 1.8;
    max-width: 350px;
  }
  .identity-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 22px;
    margin-top: 24px;
    font-size: 11px;
  }
  .work-link {
    display: inline-flex;
    align-items: center;
    gap: 20px;
    padding: 13px 16px;
    border-radius: 7px;
    background: hsl(var(--foreground));
    color: hsl(var(--background));
  }
  .work-link:hover {
    background: hsl(var(--primary));
    color: #17130f;
  }
  .about-link:hover {
    color: hsl(var(--primary));
  }
  .about-link span {
    margin-left: 8px;
  }
  .identity-portrait {
    position: absolute;
    width: 37%;
    right: 12px;
    top: 72px;
    text-align: center;
  }
  .portrait-frame-home {
    background: #edc9a1;
    border: 1px solid #d7b58f;
    border-radius: 120px 120px 24px 24px;
    padding: 18px 12px 0;
    overflow: hidden;
  }
  .identity-portrait img {
    display: block;
    width: 100%;
    height: 262px;
    object-fit: contain;
    object-position: center bottom;
    filter: none;
    mix-blend-mode: normal;
  }
  .identity-portrait > span {
    display: block;
    margin-top: 14px;
    font-family: var(--font-mono);
    font-size: 8px;
    color: hsl(var(--muted-foreground));
  }
  .identity-meta {
    display: flex;
    gap: 38px;
    border-top: 1px solid hsl(var(--border));
    padding: 20px 34px;
  }
  dt {
    color: hsl(var(--muted-foreground));
    font-family: var(--font-mono);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    font-size: 8px;
  }
  dd {
    font-size: 11px;
    font-weight: 500;
    margin-top: 5px;
  }
  a:focus-visible {
    outline: 2px solid hsl(var(--primary));
    outline-offset: 4px;
  }
  @media (max-width: 600px) {
    .identity-copy {
      padding: 26px;
      width: 100%;
    }
    h1 {
      font-size: 60px;
    }
    .identity-description {
      max-width: none;
    }
    .identity-portrait {
      display: none;
    }
    .identity-meta {
      padding: 20px 26px;
      gap: 24px;
    }
    dd {
      font-size: 10px;
    }
  }
</style>
