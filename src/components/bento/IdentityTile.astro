---
import BentoTile from './BentoTile.astro'
import { IDENTITY } from '../../lib/portfolio'
---

<BentoTile
  id="identity"
  class="order-1 col-span-1 min-h-[280px] p-6 sm:col-span-2 sm:min-h-[320px] sm:p-8 lg:col-span-7 lg:row-span-2 lg:min-h-[420px]"
  radius="soft"
  delay={0}
  as="section"
  ariaLabel="Identity"
>
  <div
    class="generative-grid anim-grid-drift pointer-events-none absolute inset-0 opacity-60"
  >
  </div>
  <div
    class="bg-primary/10 anim-breathe pointer-events-none absolute -top-8 -right-8 h-48 w-48 rounded-full blur-3xl"
  >
  </div>
  <div
    class="bg-primary/5 anim-breathe-slow pointer-events-none absolute bottom-0 left-1/3 h-32 w-32 rounded-full blur-2xl"
  >
  </div>

  <div class="relative z-10 flex h-full flex-col justify-between gap-8">
    <div>
      <p class="bento-label mb-3">Personal OS</p>
      <h1
        class="text-4xl leading-[0.95] font-semibold tracking-tight sm:text-5xl lg:text-6xl"
      >
        {IDENTITY.name}
      </h1>
      <p
        class="text-primary mt-4 font-mono text-xs tracking-[0.18em] uppercase sm:text-sm"
      >
        {IDENTITY.roleLine}
      </p>
      <p
        class="text-muted-foreground mt-5 max-w-md text-base leading-relaxed sm:text-lg"
      >
        {IDENTITY.statement}
      </p>
      <a href="/about/" class="bento-arrow text-muted-foreground mt-5">
        More about me
        <span aria-hidden="true">→</span>
      </a>
    </div>

    <dl class="border-border/80 flex flex-wrap gap-x-6 gap-y-3 border-t pt-4">
      {
        IDENTITY.meta.map((item) => (
          <div>
            <dt class="text-muted-foreground font-mono text-[0.65rem] tracking-[0.12em] uppercase">
              {item.value}
            </dt>
            <dd class="mt-0.5 text-sm font-medium">{item.label}</dd>
          </div>
        ))
      }
    </dl>
  </div>
</BentoTile>
