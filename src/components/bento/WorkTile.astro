---
import BentoTile from './BentoTile.astro'
import { SELECTED_WORK } from '../../lib/portfolio'
---

<BentoTile
  href={SELECTED_WORK.href}
  class="order-9 col-span-1 flex min-h-[200px] flex-col justify-between p-5 sm:p-6 lg:order-3 lg:col-span-3"
  radius="soft"
  delay={100}
  ariaLabel="Selected work"
>
  <div>
    <h2 class="text-base font-semibold tracking-tight">Selected work</h2>
    <ul class="mt-4 space-y-2.5">
      {
        SELECTED_WORK.themes.map((theme, i) => (
          <li
            class="bento-wake bento-wake-x flex items-center gap-3"
            style={`--wake-delay: ${i * 45}ms`}
          >
            <span
              class="border-border/70 bg-secondary/50 text-primary inline-flex size-8 shrink-0 items-center justify-center rounded-md border"
              aria-hidden="true"
            >
              {i === 0 && (
                <svg
                  class="size-4"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.6"
                >
                  <circle cx="12" cy="12" r="3" />
                  <circle cx="5" cy="6" r="2" />
                  <circle cx="19" cy="6" r="2" />
                  <circle cx="5" cy="18" r="2" />
                  <circle cx="19" cy="18" r="2" />
                  <path d="M7 7.5 10 10M17 7.5 14 10M7 16.5 10 14M17 16.5 14 14" />
                </svg>
              )}
              {i === 1 && (
                <svg
                  class="size-4"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.6"
                >
                  <rect x="5" y="7" width="14" height="12" rx="1.5" />
                  <path d="M9 19V11M12 19V9M15 19V13M5 19h14" />
                </svg>
              )}
              {i === 2 && (
                <svg
                  class="size-4"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.6"
                >
                  <path d="M4 8c0-1 4-3 8-3s8 2 8 3-4 3-8 3-8-2-8-3Z" />
                  <path d="M4 12c0-1 4-3 8-3s8 2 8 3-4 3-8 3-8-2-8-3Z" />
                  <path d="M4 16c0-1 4-3 8-3s8 2 8 3-4 3-8 3-8-2-8-3Z" />
                </svg>
              )}
              {i === 3 && (
                <svg
                  class="size-4"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.6"
                  stroke-linecap="round"
                >
                  <rect x="3" y="5" width="18" height="14" rx="2" />
                  <path d="m7 10 3 2-3 2M12 14h5" />
                </svg>
              )}
            </span>
            <span class="text-lg font-medium tracking-tight sm:text-xl">
              {theme}
            </span>
          </li>
        ))
      }
    </ul>
  </div>
  <span class="bento-arrow text-foreground mt-6">
    View work
    <span aria-hidden="true">→</span>
  </span>
</BentoTile>
