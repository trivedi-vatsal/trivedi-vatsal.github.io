---
import { FluidGradientText } from './fluid-gradient-text'
import { ContactNote } from './ContactNote'
import { LINKS } from '../lib/constants'

const socials = [
  { href: LINKS.github, label: 'GitHub' },
  { href: LINKS.linkedin, label: 'LinkedIn' },
  { href: LINKS.instagram, label: 'Instagram' },
]
---

<footer class="border-border/60 w-full border-t">
  <div
    class="mx-auto flex w-full max-w-6xl flex-col items-center justify-between gap-6 px-3 py-8 sm:px-4 md:flex-row md:items-start md:px-6"
  >
    <p
      class="text-muted-foreground text-center font-mono text-xs tracking-wide md:pt-1 md:text-left"
    >
      © {new Date().getFullYear()} Vatsal Trivedi · Built with Astro
    </p>

    <nav
      aria-label="Footer links"
      class="flex flex-col items-center gap-2 md:items-start"
    >
      <ContactNote client:visible email={LINKS.mail} label="Send a note" />
      {
        socials.map(({ href, label }) => (
          <a
            href={href}
            target="_blank"
            rel="noopener noreferrer"
            class="text-muted-foreground hover:text-foreground text-xs tracking-wide underline-offset-4 transition-colors hover:underline"
          >
            {label}
          </a>
        ))
      }
      <a
        href={LINKS.mail}
        class="text-muted-foreground hover:text-foreground text-xs tracking-wide underline-offset-4 transition-colors hover:underline"
      >
        Email
      </a>
    </nav>

    <p class="text-muted-foreground text-center text-xs md:pt-1 md:text-right">
      <a
        href="https://github.com/trivedi-vatsal/trivedi-vatsal.github.io"
        target="_blank"
        rel="noopener noreferrer"
        class="hover:text-foreground underline-offset-4 transition-colors hover:underline"
      >
        Source
      </a>
    </p>
  </div>
  <div class="text-foreground h-28 w-full sm:h-36 md:h-44 lg:h-52">
    <FluidGradientText
      client:visible
      text="Vatsal Trivedi"
      svgViewBoxWidth={2600}
    />
  </div>
</footer>
