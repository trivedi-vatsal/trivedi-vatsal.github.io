---
import type { SelectedSystem } from '../../lib/work-details'

interface Props {
  systems: SelectedSystem[]
}

const { systems } = Astro.props
---

<section aria-labelledby="selected-systems-heading" class="mt-16">
  <h2
    id="selected-systems-heading"
    class="text-2xl font-semibold tracking-tight"
  >
    Selected systems
  </h2>
  <p class="text-muted-foreground mt-2 max-w-2xl text-sm">
    The problem, what I built, and what the history shows.
  </p>

  <ol class="mt-8 space-y-10">
    {
      systems.map((system) => (
        <li class="border-border/70 border-t pt-6">
          <div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1">
            <h3 class="text-lg font-semibold tracking-tight">{system.title}</h3>
            <span class="text-muted-foreground font-mono text-xs">
              {system.context}
            </span>
          </div>

          <dl class="mt-4 grid gap-x-6 gap-y-3 text-[0.95rem] leading-relaxed sm:grid-cols-[7rem_minmax(0,1fr)]">
            <dt class="text-muted-foreground text-xs font-medium tracking-wide uppercase sm:pt-1">
              Problem
            </dt>
            <dd class="text-foreground/85">{system.problem}</dd>

            <dt class="text-muted-foreground text-xs font-medium tracking-wide uppercase sm:pt-1">
              Built
            </dt>
            <dd class="text-foreground/85">{system.built}</dd>

            <dt class="text-muted-foreground text-xs font-medium tracking-wide uppercase sm:pt-1">
              Result
            </dt>
            <dd class="text-foreground/85">{system.result}</dd>

            <dt class="text-muted-foreground text-xs font-medium tracking-wide uppercase sm:pt-1">
              Evidence
            </dt>
            <dd class="text-muted-foreground font-mono text-xs leading-relaxed sm:pt-1">
              {system.evidence}
            </dd>
          </dl>

          <ul class="mt-4 flex flex-wrap gap-1.5">
            {system.stack.map((item) => (
              <li class="bg-muted/50 text-muted-foreground inline-flex items-center rounded-md border px-1.5 py-0.5 font-mono text-xs">
                {item}
              </li>
            ))}
          </ul>
        </li>
      ))
    }
  </ol>
</section>
