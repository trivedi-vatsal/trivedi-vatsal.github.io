---
import { buttonVariants } from '../components/ui/button'
import { ModeToggle } from '../components/ui/ThemeToggle'
import { NAV_LINKS } from '../lib/constants'
import { cn } from '../lib/utils'

const pathname = Astro.url.pathname
---

<script is:inline>
  function applyTheme() {
    const theme = localStorage.getItem('theme')
    const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches
    const isDark =
      theme === 'dark' || ((theme === 'system' || theme == null) && prefersDark)
    document.documentElement.classList.toggle('dark', isDark)
  }

  applyTheme()
  document.addEventListener('astro:after-swap', applyTheme)
</script>

<header
  class="bg-background/90 supports-[backdrop-filter]:bg-background/70 border-border/60 sticky top-0 z-50 w-full border-b backdrop-blur-md"
>
  <div
    class="mx-auto flex h-14 w-full max-w-6xl items-center justify-between gap-2 px-3 sm:h-16 sm:px-4 md:px-6"
  >
    <a
      href="/"
      class="group flex shrink-0 items-center gap-2 font-semibold tracking-tight"
      aria-label="Vatsal Trivedi home"
    >
      <span
        class="border-foreground/20 group-hover:border-primary group-hover:text-primary flex h-9 w-9 items-center justify-center border font-mono text-sm transition-colors sm:h-8 sm:w-8"
      >
        V
      </span>
      <span class="sr-only sm:not-sr-only sm:inline-block sm:text-sm">
        Vatsal Trivedi
      </span>
    </a>

    <nav
      aria-label="Main navigation"
      class="flex min-w-0 items-center gap-0.5 sm:gap-1"
    >
      {
        NAV_LINKS.map((link) => {
          const active =
            pathname === link.href || pathname.startsWith(link.href)
          return (
            <a
              href={link.href}
              aria-current={active ? 'page' : undefined}
              class={cn(
                buttonVariants({ variant: 'ghost', size: 'sm' }),
                'px-2 text-xs font-medium tracking-wide sm:px-3 md:text-sm',
                active && 'bg-accent text-accent-foreground',
              )}
            >
              {link.label}
            </a>
          )
        })
      }
      <ModeToggle transition:persist client:load />
    </nav>
  </div>
</header>
