---
import { buttonVariants } from '../components/ui/button'
import { ModeToggle } from '../components/ui/ThemeToggle'
import { NAV_LINKS } from '../lib/constants'
---

<script is:inline>
  document.addEventListener('astro:after-swap', function () {
    if (localStorage.getItem('theme') === 'dark')
      document.documentElement.classList.toggle('dark', true)
  })

  const getThemePreference = () => {
    return localStorage.getItem('theme')
  }

  const isDark = getThemePreference() === 'dark'
  document.documentElement.classList[isDark ? 'add' : 'remove']('dark')
</script>

<header
  class="bg-background/90 supports-[backdrop-filter]:bg-background/70 border-border/60 sticky top-0 z-50 w-full border-b backdrop-blur-md"
>
  <div
    class="mx-auto flex h-14 w-full max-w-6xl items-center justify-between px-3 sm:h-16 sm:px-4 md:px-6"
  >
    <a
      href="/"
      class="group flex items-center gap-2 font-semibold tracking-tight"
      aria-label="Vatsal Trivedi home"
    >
      <span
        class="border-foreground/20 group-hover:border-primary group-hover:text-primary flex h-8 w-8 items-center justify-center border font-mono text-sm transition-colors"
      >
        V
      </span>
      <span class="sr-only sm:not-sr-only sm:inline-block sm:text-sm">
        Vatsal Trivedi
      </span>
    </a>

    <nav
      aria-label="Main navigation"
      class="flex items-center gap-0.5 sm:gap-1"
    >
      {
        NAV_LINKS.map((link) => (
          <a
            href={link.href}
            class={`${buttonVariants({ variant: 'ghost', size: 'sm' })} hidden text-xs font-medium tracking-wide sm:inline-flex md:text-sm`}
          >
            {link.label}
          </a>
        ))
      }
      <!-- Compact nav for very small screens -->
      <a
        href="/work/"
        class={`${buttonVariants({ variant: 'ghost', size: 'sm' })} text-xs sm:hidden`}
      >
        Work
      </a>
      <a
        href="/blog/"
        class={`${buttonVariants({ variant: 'ghost', size: 'sm' })} text-xs sm:hidden`}
      >
        Journal
      </a>
      <ModeToggle transition:persist client:load />
    </nav>
  </div>
</header>
